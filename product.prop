# Animation
persist.sys.activity_anim_perf_override=true

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# GPS
ro.oplus.mtk_gps_mpe=1

# Radio
persist.sys.oplus.radio.mtk_sa_e5gopt_option = 2
persist.vendor.entitlement_enabled=1
ro.oplus.connectivity.oversea=true
ro.oplus.radio.dual_nr_enabled=true
ro.oplus.radio.dual_nr_toggle_enabled=false
ro.oplus.radio.evdo_oos_interval=45000
ro.oplus.radio.gsm_oos_interval=48000
ro.oplus.radio.lte_oos_interval=72000
ro.oplus.radio.lte_rsrp_thresholds=-126,-121,-114,-105,-44
ro.oplus.radio.modem_reset_time=20
ro.oplus.radio.osl=1
ro.oplus.radio.sub_slot_support_sa=0
ro.vendor.mtk_md3_support=0
ro.vendor.mtk_mobile_management=0

# SKU
ro.boot.hardware.sku=lisaa
